# Database Connection Configurations
# JDBC URL format: jdbc:postgresql://<host>:<port>/<database>
DB_URL=jdbc:postgresql://your-db-host.postgres.database.azure.com:5432/smartpark?sslmode=require
DB_USER=smartpark_db_user
DB_PASSWORD=your_secure_db_password

# Database Connection Pool Sizing
DB_POOL_MAX=10
DB_POOL_MIN=2

# Security & JWT Configuration
# Generate a secure 256-bit key (64 hex characters or base64)
JWT_SECRET=your_base64_encoded_secure_jwt_signing_key_at_least_32_bytes_long
JWT_EXPIRATION=86400000

# CORS Whitelist (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://smartpark-frontend.vercel.app

# API Documentation Policy (true to enable Swagger UI in prod)
ENABLE_SWAGGER=false

# Port Binding (Managed dynamically by Cloud Run, defaults to 8080 locally)
PORT=8080
